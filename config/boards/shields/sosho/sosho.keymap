//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	behaviors {
		//エンコーダにスクロールを割り当てるためのビヘイビア(zmk_encoder モジュール)
		//press/release の2イベントではなく1イベントで完結するので、負荷時に release が欠落して固まらない
		ec_ms_l: ec_ms_h {
			compatible = "zmk,behavior-encoder-mouse-scroll";
			#sensor-binding-cells = <2>;
		};
		ec_ms_r: ec_ms_v {
			compatible = "zmk,behavior-encoder-mouse-scroll";
			#sensor-binding-cells = <2>;
		};
		//ポインタ感度(パーセント)を保持するだけのビヘイビア。設定アプリが値を書き換える
		ptr_sens: pointer_sensitivity {
			compatible = "sosho,behavior-pointer-sens";
			#binding-cells = <1>;
			display-name = "Pointer Sensitivity";
		};
	};
};

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};
/{
    combos {
        compatible = "zmk,combos";
		//左クリックのコンボ 19 J 20 K
	    combo_LCLK {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
        };

		//右クリックのコンボ 20 K 21 L
        combo_RCLK {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
        };

		//ホイールクリックのコンボ 19 J 21 L
	    combo_MCLK {
            timeout-ms = <90>;
            key-positions = <19 21>;
            bindings = <&mkp MCLK>;
        };

		//作ったけど消した。ポインティングデバイスをスクロールにしたい人向け
		//31 M 32 ,
		combo_SCROLL {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&mo 5>; //5 = scroll(reserved)。4 は PointerSettings なので使わない
        };
    };
};

/{
keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
            &kp TAB    &kp Q   &kp W  &kp E  &kp R  &kp T      &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
            &kp LCTRL  &kp A   &kp S  &kp D  &kp F  &kp G      &kp H  &kp J  &kp K      &kp L    &kp SQT   &kp ENTER
            &kp LSHFT  &kp Z   &kp X  &kp C  &kp V  &kp B      &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH &kp LSHFT
            &kp ESC    &kp LALT              &mo 2  &kp SPACE  &mo 1  &kp LA(GRAVE)              &mo 3     &kp LGUI
        >;
		//&ec_ms_lとrは、上のビヘイビアで作ったもの。
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };
	
    layer_1 {
        bindings = <
            &kp GRAVE &kp N1  &kp N2  &kp N3  &kp N4  &kp N5       &kp N6    &kp N7   &kp N8   &kp N9    &kp N0 &kp DEL
            &trans    &trans &trans &trans &trans &trans           &kp PG_UP &kp HOME &kp UP   &kp END   &trans &trans
            &trans    &trans &trans &trans &trans &trans           &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &trans &trans
            &trans    &trans               &trans &trans           &trans    &trans                      &trans &trans
        >;
    };

    layer_2 {
        bindings = <
            &trans &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &trans  &trans    &kp MINUS &kp EQUAL &trans     &trans
            &trans &kp F6  &kp F7  &kp F8  &kp F9  &kp F10    &trans  &kp LBKT  &kp RBKT  &kp NUBS  &trans     &trans
            &trans &kp F11 &kp F12 &kp F13 &kp F14 &kp F15    &trans  &kp SEMI  &kp SQT   &trans    &kp QMARK  &kp BSLH
            &trans &trans                  &trans  &trans     &trans  &trans                        &trans     &trans
        >;
    };

    layer_3 {
        bindings = <
            &trans &trans &trans &trans &trans &trans      &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4
			//左端と右端の &bootloader は書き込みモードに入るキー。押した側の半分だけが USB ドライブとして現れる
            &bootloader &trans &trans &trans &trans &trans &trans  &trans        &trans        &trans        &trans         &bootloader
            &trans &trans &trans &trans &trans &trans      &trans  &trans        &trans        &trans        &bt BT_CLR_ALL &bt BT_CLR
            &trans &trans               &trans &trans      &trans  &out OUT_BLE                                    &trans         &out OUT_USB
        >;
    };
    //設定値の置き場。このレイヤーは有効化しない(キーとしては使わない)。
    //1番目 = トラックボールの感度(パーセント)、2番目 = トラックパッドの感度(パーセント)。設定アプリが書き換える
    pointer_settings {
        display-name = "PointerSettings";
        bindings = <
            &ptr_sens 100 &ptr_sens 100 &none &none &none &none &none &none &none &none &none &none
            &none &none &none &none &none &none &none &none &none &none &none &none
            &none &none &none &none &none &none &none &none &none &none &none &none
            &none &none &none &none &none &none &none &none
        >;
    };

    //有効なレイヤーは reserved のレイヤーより前に置く(ZMK は有効なレイヤーが先頭に並ぶ前提で番号を振る)
    scroll {
        status = "reserved";
    };

    extra2 {
        status = "reserved";
    };
};
};